# Copy to .env and adjust as needed.
APP_NAME=Taskly API
DEBUG=true

# Async SQLAlchemy URLs (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://taskly:taskly@localhost:5432/taskly
TEST_DATABASE_URL=postgresql+asyncpg://taskly:taskly@localhost:5432/taskly_test

# Auth. Generate a real secret for anything but local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=insecure-dev-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# Object storage for attachments (S3-compatible). Local dev points at the MinIO
# container from docker-compose; in production use real Cloudflare R2 values.
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=taskly
R2_SECRET_ACCESS_KEY=taskly-secret
R2_BUCKET=taskly-attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_URL_TTL_SECONDS=3600
